[MAIN]
# Long, precise persona/goal text (the actual conversation content the
# agents follow) legitimately exceeds PEP8's 79-column default; 100 is a
# common modern convention and matches this project's line wrapping.
max-line-length=100

[DESIGN]
# DemoRun (server.py) deliberately centralizes one HTTP request's full run
# state as instance attributes instead of module globals, so concurrent/
# sequential runs never leak into each other — 7 is too strict for that.
max-attributes=12
# clean_data (data_tool.py) exposes 6 parameters 1:1 with its callers
# (some supplied by the wrapper, some by the model via its tool schema);
# bundling them into an options object would only obscure a simple
# data-cleaning function.
max-args=6
max-positional-arguments=6
